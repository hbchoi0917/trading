# Trading automation credentials
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values below
# 3. .env is blocked by .gitignore — it will NEVER be committed to GitHub
# ─────────────────────────────────────────────────────────────────────────────

# ── Tastytrade: safety flags (always set these) ────────────────────────────
# true  = use paper trading sandbox (recommended until you're confident)
# false = live trading (real money)
TT_PAPER_TRADING=true

# true  = log orders but do NOT submit them (safest for initial testing)
# false = actually submit orders to Tastytrade
TT_DRY_RUN=true

# Comma-separated account numbers to trade (blank = all accounts)
# Example: TT_ACCOUNT_NUMBERS=12345678,87654321
TT_ACCOUNT_NUMBERS=


# ── Tastytrade: authentication (choose ONE method) ─────────────────────────

# METHOD 1 — Paper Trading API key (simplest, recommended to start)
#   1. Log in to Tastytrade
#   2. Settings → API → Paper Trading → Generate key
#   3. Paste here:
TT_PAPER_API_KEY=

# METHOD 2 — OAuth (Live / Certification account)
#   Run:  python broker/setup_auth.py  to complete the OAuth device flow.
#   The script will write these values automatically.
TT_SECRET=
TT_REFRESH=


# ── Telegram notifications (recommended) ──────────────────────────────────
# Setup:
#   1. Message @BotFather on Telegram → /newbot → copy the token
#   2. Message your new bot once, then open:
#        https://api.telegram.org/bot<TOKEN>/getUpdates
#      Look for "id" inside "chat" — that's your chat_id
TG_BOT_TOKEN=
TG_CHAT_ID=


# ── Gmail notifications (fallback — only used if Telegram is not set) ──────
# Requires a Gmail App Password (NOT your normal password):
#   https://myaccount.google.com/apppasswords  (needs 2FA enabled)
GMAIL_SENDER=your_email@gmail.com
GMAIL_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_RECEIVER=your_email@gmail.com
