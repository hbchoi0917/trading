# Trading automation credentials
# -------------------------------------------------------
# 1. Copy this file to .env (cp .env.example .env)
# 2. Fill in your values below
# 3. .env is blocked by .gitignore — it will NEVER be committed to GitHub

# ── Tastytrade broker credentials ──────────────────────
# Sign up at https://tastytrade.com
# For paper trading (sandbox), use a Certification account:
#   https://developer.tastytrade.com  →  Create Certification Account
TT_USERNAME=your_tastytrade_username
TT_PASSWORD=your_tastytrade_password

# Set to "true" to use paper trading sandbox (CertificationSession)
# Set to "false" for live trading
TT_PAPER_TRADING=true

# Set to "true" to log orders without actually submitting them
TT_DRY_RUN=true

# Comma-separated account numbers to trade (leave blank to use all accounts)
# Example: TT_ACCOUNT_NUMBERS=12345678,87654321
TT_ACCOUNT_NUMBERS=

# ── Gmail SMTP for alert notifications ─────────────────
# Gmail App Password setup:
#   https://myaccount.google.com/apppasswords
#   (Requires 2FA enabled on your Google account)
GMAIL_SENDER=your_email@gmail.com
GMAIL_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_RECEIVER=your_email@gmail.com
